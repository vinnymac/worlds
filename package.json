{
  "name": "fantasticfour-workflow",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for @fantasticfour workflow worlds",
  "license": "Apache-2.0",
  "author": "vinnymac",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinnymac/worlds.git"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "changeset": "changeset",
    "version": "changeset version",
    "publish-packages": "pnpm build && changeset publish",
    "prepare": "husky",
    "ci:version": "changeset version",
    "ci:publish": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "turbo": "^2.9.9",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs,mts,json}": "npx oxfmt",
    "**/*.{js,jsx,ts,tsx,mjs,mts}": "npx oxlint --deny-warnings"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "pnpm": ">=11.0.0"
  },
  "volta": {
    "node": "24.18.0",
    "pnpm": "11.11.0"
  },
  "packageManager": "pnpm@11.11.0"
}
