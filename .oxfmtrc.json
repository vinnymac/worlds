{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "indentWidth": 2,
  "lineWidth": 80,
  "semicolons": "always",
  "trailingCommas": "es5",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "singleQuote": true,
  "jsxQuotes": "double",
  "quoteProps": "as-needed",
  "ignorePatterns": ["**/node_modules", "**/dist", "**/.turbo", "**/.changeset", "**/coverage"]
}
