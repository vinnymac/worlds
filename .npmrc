# pnpm v11: Allow build scripts for native dependencies
# See: https://pnpm.io/11.x/migration#build-scripts-blocking
# Native modules that require compilation
allow-builds[]=@nestjs/core
allow-builds[]=@swc/core
allow-builds[]=cbor-extract
allow-builds[]=cpu-features
allow-builds[]=esbuild
allow-builds[]=msgpackr-extract
allow-builds[]=protobufjs
allow-builds[]=sharp
allow-builds[]=ssh2
allow-builds[]=workerd
