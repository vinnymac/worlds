{
  "name": "@fantasticfour/world-firestore-tasks",
  "version": "2.3.1",
  "description": "GCP Firestore + Cloud Tasks World implementation with real-time streaming and excellent developer experience",
  "keywords": [
    "cloud-tasks",
    "durable-functions",
    "firestore",
    "gcp",
    "real-time",
    "serverless",
    "workflow"
  ],
  "license": "Apache-2.0",
  "author": "vinnymac",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinnymac/worlds.git",
    "directory": "packages/world-firestore-tasks"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.10.0",
    "@google-cloud/tasks": "^6.2.1",
    "@workflow/errors": "catalog:",
    "@workflow/utils": "catalog:",
    "@workflow/world": "catalog:",
    "ulid": "catalog:"
  },
  "devDependencies": {
    "@fantasticfour/shared": "workspace:*",
    "@testcontainers/gcloud": "12.1.0",
    "@types/node": "catalog:",
    "@workflow/world-testing": "catalog:",
    "axios": "1.19.0",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "packageManager": "pnpm@11.22.0"
}
