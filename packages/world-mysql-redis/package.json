{
  "name": "@fantasticfour/world-mysql-redis",
  "version": "1.5.3",
  "description": "Hybrid World implementation using MySQL for durable storage with Redis Lists for queue management",
  "keywords": [
    "durable-functions",
    "mysql",
    "redis",
    "workflow"
  ],
  "license": "Apache-2.0",
  "author": "vinnymac",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinnymac/worlds.git",
    "directory": "packages/world-mysql-redis"
  },
  "bin": {
    "world-mysql-redis-setup": "./bin/setup.js"
  },
  "files": [
    "dist",
    "bin",
    "migrations"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "default": "./dist/health.js"
    },
    "./migrations/*.sql": "./migrations/*.sql"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && chmod +x bin/setup.js",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "db:push": "node dist/cli.js"
  },
  "dependencies": {
    "@workflow/errors": "catalog:",
    "@workflow/utils": "catalog:",
    "@workflow/world": "catalog:",
    "cbor-x": "catalog:",
    "drizzle-orm": "catalog:",
    "ioredis": "catalog:",
    "mysql2": "catalog:",
    "ulid": "catalog:"
  },
  "devDependencies": {
    "@fantasticfour/shared": "workspace:*",
    "@fantasticfour/testing": "workspace:*",
    "@testcontainers/mysql": "catalog:",
    "@testcontainers/redis": "catalog:",
    "@types/node": "catalog:",
    "@workflow/world-testing": "catalog:",
    "drizzle-kit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "packageManager": "pnpm@11.22.0"
}
