{
  "name": "@fantasticfour/world-postgres-redis",
  "version": "2.1.2",
  "description": "Hybrid World implementation using PostgreSQL for durable storage with Redis Lists for queue management",
  "keywords": [
    "durable-functions",
    "postgres",
    "postgresql",
    "redis",
    "workflow"
  ],
  "license": "Apache-2.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinnymac/worlds.git",
    "directory": "packages/world-postgres-redis"
  },
  "bin": {
    "world-postgres-redis-setup": "./bin/setup.js"
  },
  "files": [
    "dist",
    "bin",
    "src/drizzle/migrations"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drizzle/schema": {
      "types": "./dist/drizzle/schema.d.ts",
      "default": "./dist/drizzle/schema.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./drizzle/migrations/*.sql": "./src/drizzle/migrations/*.sql"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && chmod +x bin/setup.js",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "node dist/cli.js"
  },
  "dependencies": {
    "@workflow/errors": "catalog:",
    "@workflow/world": "catalog:",
    "cbor-x": "catalog:",
    "drizzle-orm": "catalog:",
    "ioredis": "catalog:",
    "postgres": "catalog:",
    "ulid": "catalog:"
  },
  "devDependencies": {
    "@fantasticfour/shared": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@testcontainers/redis": "catalog:",
    "@types/node": "catalog:",
    "@workflow/world-testing": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "packageManager": "pnpm@11.0.5"
}
