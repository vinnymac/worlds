{
  "name": "@fantasticfour/world-azure",
  "version": "1.4.1",
  "description": "Azure Cosmos DB + Service Bus World implementation with Change Feed streaming",
  "keywords": [
    "azure",
    "cosmos-db",
    "durable-functions",
    "real-time",
    "service-bus",
    "workflow"
  ],
  "license": "Apache-2.0",
  "author": "vinnymac",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinnymac/worlds.git",
    "directory": "packages/world-azure"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/cosmos": "^4.3.1",
    "@azure/identity": "^4.9.1",
    "@azure/service-bus": "^7.9.5",
    "@workflow/errors": "catalog:",
    "@workflow/utils": "catalog:",
    "@workflow/world": "catalog:",
    "cbor-x": "^1.6.0",
    "ulid": "catalog:"
  },
  "devDependencies": {
    "@fantasticfour/shared": "workspace:*",
    "@testcontainers/azure-cosmosdb-emulator": "12.1.0",
    "@types/node": "catalog:",
    "@workflow/world-testing": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "packageManager": "pnpm@11.22.0"
}
