{
  "name": "@fantasticfour/world-nats-jetstream",
  "version": "1.3.0",
  "description": "NATS JetStream-based World implementation for self-hosted workflow execution with built-in clustering",
  "keywords": [
    "durable-functions",
    "jetstream",
    "nats",
    "self-hosted",
    "workflow"
  ],
  "license": "Apache-2.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinnymac/worlds.git",
    "directory": "packages/world-nats-jetstream"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workflow/errors": "catalog:",
    "@workflow/world": "catalog:",
    "nats": "^2.28.2",
    "ulid": "catalog:"
  },
  "devDependencies": {
    "@fantasticfour/shared": "workspace:*",
    "@types/node": "catalog:",
    "@workflow/world-testing": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "packageManager": "pnpm@11.11.0"
}
